<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Enlatados MG</title>

    <style>

        body{
            font-family: Arial;
            background-color: #f4f4f4;
            text-align: center;
            margin-top: 50px;
        }

        h1{
            color: #0d6efd;
        }

        .contenedor{
            background: white;
            width: 400px;
            margin: auto;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px gray;
        }

        button{
            background-color: #0d6efd;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover{
            background-color: #084298;
        }

    </style>

</head>

<body>

    <div class="contenedor">

        <h1>Enlatados MG</h1>

        <p>Sistema de estructuras de datos</p>

        <button>Ingresar</button>

    </div>

</body>
</html>